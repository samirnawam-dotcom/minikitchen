{
  "name": "mini-kitchen-catering",
  "version": "2.1.0",
  "description": "Mini Kitchen — Multi-Brand Website (Catering, Restaurant & Delivery) & Executive Back Office CRM powered by Node.js + Native SQLite",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test --test-reporter=spec test/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test",
    "test:e2e": "node test/e2e/smoke.js",
    "build:static": "node scripts/build-static.js"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "playwright-core": "1.56.1",
    "prettier": "3.9.10"
  },
  "optionalDependencies": {
    "better-sqlite3": "12.11.1"
  }
}
