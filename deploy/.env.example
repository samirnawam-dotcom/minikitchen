# Copy to deploy/.env on the server and fill in. Never commit the real file.

# Domain(s) Caddy serves. Use ":80" until DNS points at the server.
SITE_ADDRESS=minikitchencatering.com, www.minikitchencatering.com
SITE_URL=https://minikitchencatering.com

# First Back Office login (only used when the database is created). At least 10 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

SEED_DEMO_ORDERS=false
BACKUP_RETENTION_DAYS=14
