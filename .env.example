# ============================================================================
# MINI KITCHEN — PRODUCTION ENVIRONMENT CONFIGURATION (.env)
# ============================================================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
SITE_URL=https://minikitchencatering.com

# Reverse Proxy & HTTPS Settings
# Number of proxies in front of the app (Nginx/Caddy/Render = 1, Cloudflare + Nginx = 2).
# Leave at 0 when the app is exposed directly, otherwise clients can spoof their IP.
TRUST_PROXY=1
FORCE_HTTPS=false

# Data Directory (minikitchen.sqlite, daily backups and uploaded images)
DATA_DIR=data
SEED_DEMO_ORDERS=false
MAX_STORED_ORDERS=5000
BACKUP_RETENTION_DAYS=14

# Initial Back Office Administrator (used only when the database is first created).
# ADMIN_PASSWORD is required in production; use at least 10 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_TTL_HOURS=12
SESSION_REMEMBER_DAYS=14
