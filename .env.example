# ============================================================================
# MINI KITCHEN — PRODUCTION ENVIRONMENT CONFIGURATION (.env)
# ============================================================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
SITE_URL=https://minikitchencatering.com

# Reverse Proxy & HTTPS Settings (Enable when behind Nginx, Caddy, Cloudflare, Render, Railway)
TRUST_PROXY=true
FORCE_HTTPS=false

# SQLite Database Directory (Persists minikitchen.sqlite & daily backups)
DATA_DIR=data
SEED_DEMO_ORDERS=false
MAX_STORED_ORDERS=5000
BACKUP_RETENTION_DAYS=14

# Initial Back Office Administrator Credentials (Used on first database creation)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=minikitchen2026
SESSION_TTL_HOURS=12
SESSION_REMEMBER_DAYS=14
